PORT=3000
NODE_ENV=development

INTERNAL_SERVICE_TOKEN=dev-internal-token
ADMIN_API_TOKEN=dev-admin-token

# Opcional: si se deja vacio, BearerAuthGuard solo acepta el token demo
# literal (CONTRACT.md) y rechaza cualquier JWT real con 401.
SUPABASE_URL=https://cgnqftclzhgjlzollzye.supabase.co

# Cualquier connection string al mismo proyecto Supabase sirve — la query
# de auditoria siempre califica el schema completo (audit._x27f_evt_trace),
# no depende del ?schema= de esta URL. Sin esto, GET /admin/audit responde
# 503 en vez de romper el resto del gateway.
AUDIT_DATABASE_URL=

CATALOG_SERVICE_URL=http://catalog-service:3002
COUPON_SERVICE_URL=http://coupon-service:3003
DISCOUNT_SERVICE_URL=http://discount-service:3001
ORDER_SERVICE_URL=http://order-service:3004

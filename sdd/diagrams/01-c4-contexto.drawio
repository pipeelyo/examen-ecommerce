        <mxCell id="n2" value="&lt;font style='font-size:20px'&gt;&lt;b&gt;Fig. C4 — Contexto de sistema&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#5B6473'&gt;SDD §01 · Quién usa el sistema y con qué sistemas externos habla  |  Core E-Commerce Checkout&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E3EBF7;strokeColor=#2E5EAA;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#1A2233;align=left;verticalAlign=middle;spacing=12;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="64" as="geometry"/></mxCell>

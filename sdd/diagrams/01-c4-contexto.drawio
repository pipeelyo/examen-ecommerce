        <mxCell id="n4" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#E3EBF7;strokeColor=#2E5EAA;fontSize=13;fontColor=#1A2233;" vertex="1" parent="1"><mxGeometry x="80" y="520" width="80" height="100" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;Core E-Commerce&lt;br&gt;Checkout&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;React + NestJS (6 micros)&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#8890A0'&gt;Único producto de la prueba&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E3EBF7;strokeColor=#2E5EAA;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="420" y="280" width="340" height="280" as="geometry"/></mxCell>
        <mxCell id="n6" value="&lt;b&gt;Supabase Auth&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;Identidad email/password&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#8890A0'&gt;JWKS · JWT (JWS)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E3F3EA;strokeColor=#2F8F5B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="980" y="160" width="240" height="110" as="geometry"/></mxCell>

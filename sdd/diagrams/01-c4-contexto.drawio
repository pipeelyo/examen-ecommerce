        <mxCell id="n8" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;Pub/Sub · cache · semáforo pool&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#EAECF1;strokeColor=#2E5EAA;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;" vertex="1" parent="1"><mxGeometry x="980" y="480" width="240" height="110" as="geometry"/></mxCell>

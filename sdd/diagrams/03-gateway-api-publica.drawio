<mxfile host="app.diagrams.net" agent="Cursor" version="22.1.0">
  <diagram id="gw-pub" name="API Gateway — único punto público">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n2" value="&lt;font style='font-size:20px'&gt;&lt;b&gt;API Gateway como única API pública&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#5B6473'&gt;SDD §07 · Internos = ClusterIP / red docker-compose · nunca Ingress&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E3EBF7;strokeColor=#2E5EAA;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#1A2233;align=left;verticalAlign=middle;spacing=12;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1720" height="64" as="geometry"/></mxCell>
        <mxCell id="n3" value="Internet / navegador" style="swimlane;html=1;fillColor=#FAE4E1;strokeColor=#C1C7D3;strokeWidth=1.5;fontStyle=1;startSize=40;fontSize=15;fontColor=#1F4685;fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="280" height="640" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;Cliente React&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;no conoce micros&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C0392B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;Admin UI&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;RolesGuard ADMIN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C0392B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="300" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="n6" value="Borde" style="swimlane;html=1;fillColor=#E3EBF7;strokeColor=#C1C7D3;strokeWidth=1.5;fontStyle=1;startSize=40;fontSize=15;fontColor=#1F4685;fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="350" y="100" width="420" height="640" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;api-gateway :3000&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#D9E2F1'&gt;/api/v1/*  +  /api/docs&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#C5D0E0'&gt;JWT + X-Internal-Token hacia adentro&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#2E5EAA;strokeColor=#1F4685;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="390" y="200" width="340" height="160" as="geometry"/></mxCell>
        <mxCell id="n8" value="&lt;b&gt;Público&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;GET products · preview · coupons/available&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#8890A0'&gt;POST checkout · admin detrás de IAM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2E5EAA;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="390" y="400" width="340" height="200" as="geometry"/></mxCell>
        <mxCell id="n9" value="Red interna — ClusterIP  ·  header X-Internal-Token" style="swimlane;html=1;fillColor=#E3F3EA;strokeColor=#C1C7D3;strokeWidth=1.5;fontStyle=1;startSize=40;fontSize=15;fontColor=#1F4685;fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="100" width="960" height="640" as="geometry"/></mxCell>
        <mxCell id="n10" value="&lt;b&gt;catalog :3002&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;GET /products  ·  /internal/stock/*&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2F8F5B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="840" y="170" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="n11" value="&lt;b&gt;coupon :3003&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;/available  ·  /internal/coupons/resolve&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C1652E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1140" y="170" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="n12" value="&lt;b&gt;discount :3001&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;/internal/discounts/calculate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2E5EAA;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1440" y="170" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="n13" value="&lt;b&gt;order :3004&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;POST /checkout  (saga)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#1F4685;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="990" y="320" width="340" height="110" as="geometry"/></mxCell>
        <mxCell id="n14" value="&lt;b&gt;notification&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;sin endpoint HTTP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#8890A0;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1360" y="320" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="n15" value="&lt;b&gt;Prohibido&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;Ningún interno pasa por Ingress&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#8890A0'&gt;En GKE: ClusterIP. En local: red compose. Rechazo sin X-Internal-Token. Enterprise: mTLS.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FAE4E1;strokeColor=#C0392B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="840" y="480" width="880" height="140" as="geometry"/></mxCell>
        <mxCell id="n16" value="&lt;b&gt;Por qué / decisión&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#1A2233'&gt;Un solo punto público evita exponer 5 superficies de ataque y duplicar JWT en cada micro. Los internos confían en la red cerrada y un token compartido (trade-off documentado: no re-verificar Supabase en cada hop). Montos: el motor trabaja en centavos enteros; el contrato público (CONTRACT) expone dólares con 2 decimales — la conversión vive en el gateway, no se cambia el motor. Preview no pasa por order-service: idempotente, sin stock ni persistencia.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=22;fillColor=#F7E9DD;strokeColor=#C1652E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;align=left;verticalAlign=top;spacing=10;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="1720" height="330" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

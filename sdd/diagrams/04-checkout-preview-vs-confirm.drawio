<mxfile host="app.diagrams.net" agent="Cursor" version="22.1.0">
  <diagram id="chk-gold" name="Checkout — preview vs confirm">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1220" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n2" value="&lt;font style='font-size:20px'&gt;&lt;b&gt;Flujo dorado de checkout: preview vs confirm&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#5B6473'&gt;SDD §02 HU2/HU3 · §05 · §07  |  Mismo discount-service, distinto orquestador&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E3EBF7;strokeColor=#2E5EAA;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#1A2233;align=left;verticalAlign=middle;spacing=12;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1820" height="64" as="geometry"/></mxCell>
        <mxCell id="n3" value="PREVIEW  —  POST /api/v1/checkout/preview" style="swimlane;html=1;fillColor=#E3F3EA;strokeColor=#C1C7D3;strokeWidth=1.5;fontStyle=1;startSize=40;fontSize=15;fontColor=#1F4685;fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="900" height="520" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;font color='#1F4685' style='font-size:16px'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Cliente aplica cupón&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;debounce 300 ms&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2F8F5B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;font color='#1F4685' style='font-size:16px'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;gateway → coupon.resolve&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;vigencia valid_from / valid_to&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#C1652E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;" vertex="1" parent="1"><mxGeometry x="350" y="160" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="n6" value="&lt;font color='#1F4685' style='font-size:16px'&gt;&lt;b&gt;3&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;gateway → discount.calculate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;cascada + tope 35%&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2E5EAA;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;" vertex="1" parent="1"><mxGeometry x="650" y="160" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;font color='#1F4685' style='font-size:16px'&gt;&lt;b&gt;4&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Desglose en UI&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;orderId = null · sin persistir&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2F8F5B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;" vertex="1" parent="1"><mxGeometry x="200" y="360" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="n8" value="&lt;font color='#1F4685' style='font-size:16px'&gt;&lt;b&gt;—&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;NO llama order-service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;NO reserva stock&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FBF0DC;strokeColor=#B8862B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;" vertex="1" parent="1"><mxGeometry x="540" y="360" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="n9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E5EAA;strokeWidth=2;fontSize=12;fontColor=#5B6473;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E5EAA;strokeWidth=2;fontSize=12;fontColor=#5B6473;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E5EAA;strokeWidth=2;fontSize=12;fontColor=#5B6473;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n12" value="CONFIRM  —  POST /api/v1/checkout" style="swimlane;html=1;fillColor=#E3EBF7;strokeColor=#C1C7D3;strokeWidth=1.5;fontStyle=1;startSize=40;fontSize=15;fontColor=#1F4685;fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="970" y="100" width="890" height="520" as="geometry"/></mxCell>
        <mxCell id="n13" value="&lt;font color='#1F4685' style='font-size:16px'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Click Pagar&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;Bearer demo o JWT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2E5EAA;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;" vertex="1" parent="1"><mxGeometry x="1000" y="160" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="n14" value="&lt;font color='#1F4685' style='font-size:16px'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Saga en order-service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;catalog → coupon → discount&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F4685;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;" vertex="1" parent="1"><mxGeometry x="1240" y="160" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="n15" value="&lt;font color='#1F4685' style='font-size:16px'&gt;&lt;b&gt;3&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Tx: order + items + outbox&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;201 + breakdown&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2F8F5B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;" vertex="1" parent="1"><mxGeometry x="1000" y="360" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="n16" value="&lt;font color='#1F4685' style='font-size:16px'&gt;&lt;b&gt;4&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;SSE OrderConfirmed&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;cliente no espera el push&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2E5EAA;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;" vertex="1" parent="1"><mxGeometry x="1310" y="360" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="n17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E5EAA;strokeWidth=2;fontSize=12;fontColor=#5B6473;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E5EAA;strokeWidth=2;fontSize=12;fontColor=#5B6473;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n19" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2F8F5B;strokeWidth=2;fontSize=12;fontColor=#5B6473;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n20" value="&lt;b&gt;Por qué / decisión&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#1A2233'&gt;Preview y confirm no duplican reglas: ambos usan el mismo discount-service. Preview omite order-service porque no hay nada que persistir ni stock que reservar — es seguro llamarlo en cada tecleo. Confirm orquesta la saga (el único camino con efectos). El commit HTTP 201 y el evento SSE están desacoplados: el cliente nunca espera al canal asíncrono (Fig. 3). Caso dorado de demo: Laptop $700 + Mouse $50 + Libro $30 + WELCOME2026 → total 569.29 (27.02%), tope 35% no se activa.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=22;fillColor=#F7E9DD;strokeColor=#C1652E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;align=left;verticalAlign=top;spacing=10;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1820" height="280" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

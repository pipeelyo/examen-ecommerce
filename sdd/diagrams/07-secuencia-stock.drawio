        <mxCell id="n18" value="stock += qty" style="html=1;endArrow=block;endFill=1;strokeColor=#C0392B;strokeWidth=2;fontSize=13;fontColor=#1A2233;labelBackgroundColor=#FFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="930" y="650" as="sourcePoint"/><mxPoint x="1330" y="650" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n19" value="500 — la orden no existe" style="html=1;endArrow=block;endFill=1;strokeColor=#C0392B;strokeWidth=2;fontSize=13;fontColor=#1A2233;labelBackgroundColor=#FFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="530" y="720" as="sourcePoint"/><mxPoint x="190" y="720" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n20" value="&lt;b&gt;Por qué / decisión&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#1A2233'&gt;Reservar, resolver cupón y calcular son de solo lectura o reversibles si fallan antes de completarse. El único efecto persistente previo al commit es la reserva en catalog-service; por eso es el único con compensación explícita (release). Soft delete de productos (HU6) nunca borra filas referenciadas por order_items históricos. Ajuste admin de stock es atómico: UPDATE … SET stock = stock + delta WHERE stock + delta &amp;gt;= 0 — mismo cuidado que reserveStock.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=22;fillColor=#F7E9DD;strokeColor=#C1652E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;align=left;verticalAlign=top;spacing=10;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="80" y="820" width="1540" height="220" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

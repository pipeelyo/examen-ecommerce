        <mxCell id="n16" value="Si persistencia de la orden falla DESPUÉS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FAE4E1;strokeColor=#C0392B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="520" width="1540" height="200" as="geometry"/></mxCell>

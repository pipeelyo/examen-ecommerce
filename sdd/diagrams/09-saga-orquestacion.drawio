<mxfile host="app.diagrams.net" agent="Cursor" version="22.1.0">
  <diagram id="saga" name="Saga de checkout (orquestación)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n2" value="&lt;font style='font-size:20px'&gt;&lt;b&gt;Fig. 5 — Saga por orquestación&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#5B6473'&gt;SDD §09 · order-service es el único orquestador y el único que sabe compensar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E3EBF7;strokeColor=#2E5EAA;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#1A2233;align=left;verticalAlign=middle;spacing=12;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="64" as="geometry"/></mxCell>
        <mxCell id="n3" value="&lt;b&gt;1. checkout recibido&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;order-service&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E3EBF7;strokeColor=#2E5EAA;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="160" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;2. Reservar stock&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;catalog-service&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E3F3EA;strokeColor=#2F8F5B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="160" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;Abortar 409&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;nada persistido&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FAE4E1;strokeColor=#C0392B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="320" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="n6" value="&lt;b&gt;3. Resolver cupón&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;coupon-service&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F7E9DD;strokeColor=#C1652E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="720" y="160" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;4. Calcular + tope 35%&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;discount-service&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E3EBF7;strokeColor=#2E5EAA;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="160" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="n8" value="&lt;b&gt;5. Persistir tx propia&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;orden + items + outbox&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#1F4685;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1340" y="160" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="n9" value="&lt;b&gt;COMPENSAR: release stock&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;catalog-service&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FAE4E1;strokeColor=#C0392B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="360" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="n10" value="&lt;b&gt;500 — la orden no existe&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FAE4E1;strokeColor=#C0392B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1040" y="500" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="n11" value="&lt;b&gt;201 + breakdown&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E3F3EA;strokeColor=#2F8F5B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1340" y="360" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="n12" value="&lt;b&gt;OutboxRelay → Redis&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;OrderConfirmed&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#8890A0'&gt;Pub/Sub&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EAECF1;strokeColor=#2E5EAA;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1340" y="500" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="n13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E5EAA;strokeWidth=2;fontSize=12;fontColor=#5B6473;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n14" value="sin stock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E5EAA;strokeWidth=2;fontSize=12;fontColor=#5B6473;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n15" value="reservado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E5EAA;strokeWidth=2;fontSize=12;fontColor=#5B6473;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E5EAA;strokeWidth=2;fontSize=12;fontColor=#5B6473;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E5EAA;strokeWidth=2;fontSize=12;fontColor=#5B6473;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n18" value="fallo persistencia" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C0392B;strokeWidth=2;fontSize=12;fontColor=#5B6473;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n19" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C0392B;strokeWidth=2;fontSize=12;fontColor=#5B6473;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n20" value="OK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2F8F5B;strokeWidth=2;fontSize=12;fontColor=#5B6473;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="n8" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2F8F5B;strokeWidth=2;fontSize=12;fontColor=#5B6473;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n22" value="&lt;b&gt;Por qué / decisión&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#1A2233'&gt;Se elige saga por orquestación (no coreografía) porque el flujo es lineal y de cuatro pasos: una cadena de eventos sería más difícil de seguir para el mismo resultado. La coreografía se reserva para DESPUÉS de OrderConfirmed (notificación, y el día que exista pasarela de pago externa). Con 6 micros la saga dejó de ser 'documentada para el futuro': es parte del MVP. Redis Pub/Sub es at-most-once — riesgo aceptado; EventPublisher permite cambiar a RabbitMQ sin reescribir order-service.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=22;fillColor=#F7E9DD;strokeColor=#C1652E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;align=left;verticalAlign=top;spacing=10;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="80" y="640" width="1540" height="280" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

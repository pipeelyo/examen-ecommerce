        <mxCell id="n8" value="&lt;b&gt;Una instancia PostgreSQL (Supabase)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;un backup · una factura&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#F7E9DD;strokeColor=#C1652E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;" vertex="1" parent="1"><mxGeometry x="560" y="400" width="680" height="120" as="geometry"/></mxCell>
        <mxCell id="n9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E5EAA;strokeWidth=2;fontSize=12;fontColor=#5B6473;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="n3" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>

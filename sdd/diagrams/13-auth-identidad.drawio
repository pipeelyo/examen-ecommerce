<mxfile host="app.diagrams.net" agent="Cursor" version="22.1.0">
  <diagram id="auth" name="Identidad y auth">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1280" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n2" value="&lt;font style='font-size:20px'&gt;&lt;b&gt;Flujo de identidad&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#5B6473'&gt;SDD §08 + SDD servicios 07/08 · Demo (CONTRACT) convive con Supabase Auth (diseño)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E3EBF7;strokeColor=#2E5EAA;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#1A2233;align=left;verticalAlign=middle;spacing=12;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1720" height="64" as="geometry"/></mxCell>
        <mxCell id="n3" value="A · Contrato del front (MVP demostrable)" style="swimlane;html=1;fillColor=#FBF0DC;strokeColor=#C1C7D3;strokeWidth=1.5;fontStyle=1;startSize=40;fontSize=15;fontColor=#1F4685;fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="560" height="520" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;font color='#1F4685' style='font-size:16px'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Login demo en UI&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;ana.rios@norte.shop — no pega a Supabase Auth&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#B8862B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="500" height="90" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;font color='#1F4685' style='font-size:16px'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Authorization: Bearer demo&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;token literal del CONTRACT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#B8862B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;" vertex="1" parent="1"><mxGeometry x="70" y="270" width="500" height="90" as="geometry"/></mxCell>
        <mxCell id="n6" value="&lt;font color='#1F4685' style='font-size:16px'&gt;&lt;b&gt;3&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;BearerAuthGuard&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;solo exige Bearer no vacío en checkout&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#B8862B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;" vertex="1" parent="1"><mxGeometry x="70" y="380" width="500" height="90" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;font color='#1F4685' style='font-size:16px'&gt;&lt;b&gt;4&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Rutas CONTRACT no cambian&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;evitar 401 masivo si se exigiera JWT real&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#B8862B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;" vertex="1" parent="1"><mxGeometry x="70" y="490" width="500" height="90" as="geometry"/></mxCell>
        <mxCell id="n8" value="B · SDD original (Supabase Auth)" style="swimlane;html=1;fillColor=#E3F3EA;strokeColor=#C1C7D3;strokeWidth=1.5;fontStyle=1;startSize=40;fontSize=15;fontColor=#1F4685;fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="620" y="100" width="560" height="520" as="geometry"/></mxCell>
        <mxCell id="n9" value="&lt;font color='#1F4685' style='font-size:16px'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Frontend → Supabase Auth&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;email/password · no hay login propio&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2F8F5B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;" vertex="1" parent="1"><mxGeometry x="650" y="160" width="500" height="90" as="geometry"/></mxCell>
        <mxCell id="n10" value="&lt;font color='#1F4685' style='font-size:16px'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;JWT firmado (JWS)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;sub, email, exp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2F8F5B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;" vertex="1" parent="1"><mxGeometry x="650" y="270" width="500" height="90" as="geometry"/></mxCell>
        <mxCell id="n11" value="&lt;font color='#1F4685' style='font-size:16px'&gt;&lt;b&gt;3&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;SupabaseAuthGuard + JWKS&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;JWKS cacheado · no round-trip por request&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2F8F5B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;" vertex="1" parent="1"><mxGeometry x="650" y="380" width="500" height="90" as="geometry"/></mxCell>
        <mxCell id="n12" value="&lt;font color='#1F4685' style='font-size:16px'&gt;&lt;b&gt;4&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Roles en identity.user_roles&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;CUSTOMER / ADMIN — no van en el JWT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2F8F5B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;" vertex="1" parent="1"><mxGeometry x="650" y="490" width="500" height="90" as="geometry"/></mxCell>
        <mxCell id="n13" value="C · Invitado HU5 + Enterprise" style="swimlane;html=1;fillColor=#E3EBF7;strokeColor=#C1C7D3;strokeWidth=1.5;fontStyle=1;startSize=40;fontSize=15;fontColor=#1F4685;fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1200" y="100" width="560" height="520" as="geometry"/></mxCell>
        <mxCell id="n14" value="&lt;font color='#1F4685' style='font-size:16px'&gt;&lt;b&gt;1&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Continuar como invitado&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;guestInfo obligatorio&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2E5EAA;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;" vertex="1" parent="1"><mxGeometry x="1230" y="160" width="500" height="90" as="geometry"/></mxCell>
        <mxCell id="n15" value="&lt;font color='#1F4685' style='font-size:16px'&gt;&lt;b&gt;2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;JWE en reposo&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;guest_info_enc  A256GCM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2E5EAA;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;" vertex="1" parent="1"><mxGeometry x="1230" y="270" width="500" height="90" as="geometry"/></mxCell>
        <mxCell id="n16" value="&lt;font color='#1F4685' style='font-size:16px'&gt;&lt;b&gt;3&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Proveedores sociales&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;Nivel Enterprise §01 — no se nombra un IdP concreto&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2E5EAA;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;" vertex="1" parent="1"><mxGeometry x="1230" y="380" width="500" height="90" as="geometry"/></mxCell>
        <mxCell id="n17" value="&lt;font color='#1F4685' style='font-size:16px'&gt;&lt;b&gt;4&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;mTLS + Workload Identity&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;reemplaza X-Internal-Token&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2E5EAA;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;" vertex="1" parent="1"><mxGeometry x="1230" y="490" width="500" height="90" as="geometry"/></mxCell>
        <mxCell id="n18" value="&lt;b&gt;Por qué / decisión&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#1A2233'&gt;Firebase Auth se descartó: Supabase ya es el Postgres de la semilla — un solo proveedor de identidad y datos. JWE no cifra la sesión: el JWT viaja por HTTPS y solo lleva claims; cifrarlo no aportaba. JWE sí cifra el bloque sensible de invitado en reposo. El CONTRACT del front usa Bearer demo; el SDD HTML describe JWT real. Resolución documentada (08-real-database-and-auth): no conectar SupabaseAuthGuard a las rutas del contrato hasta que el front deje el token demo — se construye en paralelo. Adapter IdentityProvider: migrar a Auth0/Cognito toca un solo servicio. Roles ADMIN/CUSTOMER/SERVICE_ACCOUNT.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=22;fillColor=#F7E9DD;strokeColor=#C1652E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;align=left;verticalAlign=top;spacing=10;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1720" height="360" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

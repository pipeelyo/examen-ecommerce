<mxfile host="app.diagrams.net" agent="Cursor" version="22.1.0">
  <diagram id="outbox" name="Outbox y eventos">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n2" value="&lt;font style='font-size:20px'&gt;&lt;b&gt;Outbox transaccional + Redis Pub/Sub&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#5B6473'&gt;SDD §09 · Base del Event Sourcing pedido, sin event store completo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E3EBF7;strokeColor=#2E5EAA;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#1A2233;align=left;verticalAlign=middle;spacing=12;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="64" as="geometry"/></mxCell>
        <mxCell id="n3" value="&lt;b&gt;Misma transacción Postgres (schema order)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E3EBF7;strokeColor=#2E5EAA;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="140" width="700" height="280" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;INSERT orders + order_items&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;cambio de negocio&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2E5EAA;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="120" y="200" width="280" height="160" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;INSERT outbox_events&lt;br&gt;status=PENDING&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;en la misma tx&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#C1652E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="440" y="200" width="300" height="160" as="geometry"/></mxCell>
        <mxCell id="n6" value="&lt;b&gt;OutboxRelay&lt;br&gt;(dentro de order-service)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;polling PENDING&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F7E9DD;strokeColor=#C1652E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="860" y="180" width="320" height="160" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;Redis  canal order.events&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;at-most-once&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#EAECF1;strokeColor=#2E5EAA;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;" vertex="1" parent="1"><mxGeometry x="1260" y="180" width="360" height="160" as="geometry"/></mxCell>
        <mxCell id="n8" value="&lt;b&gt;notification-service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;confirmación stub MVP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#8890A0;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="860" y="420" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="n9" value="&lt;b&gt;api-gateway SSE&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#5B6473'&gt;push al navegador de esa compra&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#2E5EAA;strokeWidth=1.5;fontFamily=Helvetica;fontSize=14;fontColor=#1A2233;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1260" y="420" width="360" height="100" as="geometry"/></mxCell>
        <mxCell id="n10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E5EAA;strokeWidth=2;fontSize=12;fontColor=#5B6473;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="n3" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n11" value="PUBLISHED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E5EAA;strokeWidth=2;fontSize=12;fontColor=#5B6473;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E5EAA;strokeWidth=2;fontSize=12;fontColor=#5B6473;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E5EAA;strokeWidth=2;fontSize=12;fontColor=#5B6473;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n14" value="&lt;b&gt;Por qué / decisión&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#1A2233'&gt;RabbitMQ/CloudAMQP se reemplazó por Redis (ya estaba para pool/cache) + Outbox + SSE: un broker durable es infra extra para un volumen mínimo (una orden, un consumidor). El publicador implementa EventPublisher: RedisPubSubPublisher hoy, RabbitMqEventPublisher mañana — sin reescribir la saga. Si notification está caído, el mensaje se pierde para él (at-most-once); la orden no. PENDING en outbox sigue siendo la fuente de verdad para reprocesar. Observer: los suscriptores no conocen a order-service, solo el evento.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=22;fillColor=#F7E9DD;strokeColor=#C1652E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;align=left;verticalAlign=top;spacing=10;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="80" y="580" width="1540" height="300" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

<mxfile host="app.diagrams.net" agent="Cursor" version="22.1.0">
  <diagram id="mvp-ent" name="MVP vs Enterprise">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n2" value="&lt;font style='font-size:20px'&gt;&lt;b&gt;Dos niveles de arquitectura&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#5B6473'&gt;SDD §01 · Trade-off simplicidad vs extensibilidad (docs/arquitectura.md)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E3EBF7;strokeColor=#2E5EAA;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#1A2233;align=left;verticalAlign=middle;spacing=12;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1720" height="64" as="geometry"/></mxCell>
        <mxCell id="n3" value="Nivel MVP — se codifica, ≥80% cobertura, se demuestra" style="swimlane;html=1;fillColor=#E3F3EA;strokeColor=#C1C7D3;strokeWidth=1.5;fontStyle=1;startSize=40;fontSize=15;fontColor=#1F4685;fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="850" height="560" as="geometry"/></mxCell>
        <mxCell id="n4" value="• Postgres vía Supabase (mismo proveedor local/prod)&lt;br&gt;• Prisma Migrate + seed.ts&lt;br&gt;• Supabase Auth email/password + invitado HU5  /  Bearer demo en CONTRACT&lt;br&gt;• Redis Pub/Sub + SSE&lt;br&gt;• Saga orquestada en order-service + compensación stock&lt;br&gt;• Pool nativo Prisma/pg&lt;br&gt;• docker compose up&lt;br&gt;• Errores tipados + reintentos simples" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontColor=#1A2233;fontFamily=Helvetica;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="790" height="460" as="geometry"/></mxCell>
        <mxCell id="n5" value="Nivel Enterprise — diseñado, interfaces en el MVP, infra no levantada" style="swimlane;html=1;fillColor=#E3EBF7;strokeColor=#C1C7D3;strokeWidth=1.5;fontStyle=1;startSize=40;fontSize=15;fontColor=#1F4685;fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="920" y="100" width="840" height="560" as="geometry"/></mxCell>
        <mxCell id="n6" value="• Cloud SQL HA multi-región&lt;br&gt;• prisma migrate deploy en CI&lt;br&gt;• Proveedores sociales + RLS por rol&lt;br&gt;• RabbitMQ (entrega garantizada, DLQ) cuando haga falta&lt;br&gt;• Saga coreografía post-pago + circuit breaker por servicio&lt;br&gt;• Redis semáforo + PgBouncer&lt;br&gt;• GKE Ingress HPA Secret Manager Cloud Build&lt;br&gt;• opossum + colas de reintento con backoff" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontColor=#1A2233;fontFamily=Helvetica;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="950" y="160" width="780" height="460" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;Por qué / decisión&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#1A2233'&gt;Construir literalmente K8s+IAM+Event Sourcing+cifrado+pool Redis como código funcional contradice el criterio de evaluación (cantidad de código). El MVP ya deja las costuras: EventPublisher, IdentityProvider, mismos 6 procesos que GKE desplegará. Ajustes durante el diseño: Firebase→Supabase Auth; JWE de sesión→JWS + JWE solo en guest_info; Liquibase duplicado→solo Prisma; RabbitMQ→Redis Pub/Sub. Patrones exigidos (mín. 2, se implementan 6): Strategy, Factory, Observer, Adapter, Repository, Saga.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=22;fillColor=#F7E9DD;strokeColor=#C1652E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#1A2233;align=left;verticalAlign=top;spacing=10;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1720" height="320" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
